<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--tradable stone blocks credit to steam user Meow for their mod "Tradable Stone Blocks"-->
	<Operation Class="PatchOperationReplace">
		<xpath>*/ThingDef[@Name = "StoneBlocksBase"]/tradeability</xpath>
		<value>
			<tradeability>All</tradeability>
		</value>
	</Operation>
	<!--tradable ambrosia-->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName = "Ambrosia"]/tradeability</xpath>
		<value>
			<tradeability>All</tradeability>
		</value>
	</Operation>
	<!--tradable meals part 1 credit to steam user Meow for their mod "Tradable Meals"-->
    <Operation Class="PatchOperationReplace">
        <xpath>*/ThingDef[@Name = "MealCookedIngredientless"]/tradeability</xpath>
        <value>
			<tradeability>All</tradeability>
		</value>
	</Operation>
	<!--tradable meals part 2 credit to steam user Meow for their mod "Tradable Meals"-->
	<Operation Class="PatchOperationReplace">
        <xpath>*/ThingDef[@ParentName = "MealBase"]/tradeability</xpath>
        <value>
			<tradeability>All</tradeability>
		</value>
	</Operation>
	<!--tradable mech healer serums"-->
	<Operation Class="PatchOperationReplace">
        <xpath>*/ThingDef[defName = "MechSerumHealer"]/tradeability</xpath>
        <value>
			<tradeability>All</tradeability>
		</value>
	</Operation>
	<!--tradable mech resurrector serums"-->
	<Operation Class="PatchOperationReplace">
        <xpath>*/ThingDef[defName = "MechSerumResurrector"]/tradeability</xpath>
        <value>
			<tradeability>All</tradeability>
		</value>
	</Operation>
</Patch>